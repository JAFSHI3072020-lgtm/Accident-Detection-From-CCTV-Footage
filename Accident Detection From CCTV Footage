pture(\n        video_path\n    )\n\n\n    if not cap.isOpened():\n\n        return (\n            None,\n            \"❌ VIDEO ERROR\",\n            \"0.00%\",\n            \"Could not open video.\"\n        )\n\n\n    fps = cap.get(\n        cv2.CAP_PROP_FPS\n    )\n\n    if fps <= 0:\n\n        fps = 30\n\n\n    width = int(\n        cap.get(\n            cv2.CAP_PROP_FRAME_WIDTH\n        )\n    )\n\n\n    height = int(\n        cap.get(\n            cv2.CAP_PROP_FRAME_HEIGHT\n        )\n    )\n\n\n    output_path = (\n        \"/kaggle/working/\"\n        \"roadvision_dashboard_output.mp4\"\n    )\n\n\n    writer = cv2.VideoWriter(\n\n        output_path,\n\n        cv2.VideoWriter_fourcc(\n            *\"mp4v\"\n        ),\n\n        fps,\n\n        (width, height)\n    )\n\n\n    probability_history = []\n\n    consecutive = 0\n\n    confirmed = False\n\n    max_probability = 0.0\n\n    alert_count = 0\n\n    frame_number = 0\n\n\n    while True:\n\n        success, frame = cap.read()\n\n\n        if not success:\n\n            break\n\n\n        frame_number += 1\n\n\n        # ----------------------------------------------------\n        # BGR → RGB\n        # ----------------------------------------------------\n\n        rgb = cv2.cvtColor(\n\n            frame,\n\n            cv2.COLOR_BGR2RGB\n        )\n\n\n        probability = dashboard_predict(\n            rgb\n        )\n\n\n        max_probability = max(\n            max_probability,\n            probability\n        )\n\n\n        # ----------------------------------------------------\n        # Smoothing\n        # ----------------------------------------------------\n\n        probability_history.append(\n            probability\n        )\n\n\n        if len(\n            probability_history\n        ) > 5:\n\n            probability_history.pop(\n                0\n            )\n\n\n        smooth_probability = np.mean(\n            probability_history\n        )\n\n\n        # ----------------------------------------------------\n        # Temporal confirmation\n        # ----------------------------------------------------\n\n        if smooth_probability >= threshold:\n\n            consecutive += 1\n\n        else:\n\n            consecutive = 0\n\n\n        if consecutive >= consecutive_required:\n\n            confirmed = True\n\n            alert_count += 1\n\n\n        # ----------------------------------------------------\n        # Overlay\n        # ----------------------------------------------------\n\n        if confirmed:\n\n            cv2.rectangle(\n\n                frame,\n\n                (0, 0),\n\n                (width - 1, height - 1),\n\n                (0, 0, 255),\n\n                10\n            )\n\n\n            cv2.rectangle(\n\n                frame,\n\n                (15, 55),\n\n                (720, 135),\n\n                (0, 0, 255),\n\n                -1\n            )\n\n\n            cv2.putText(\n\n                frame,\n\n                \"!!! ACCIDENT DETECTED !!!\",\n\n                (35, 110),\n\n                cv2.FONT_HERSHEY_SIMPLEX,\n\n                1.1,\n\n                (255, 255, 255),\n\n                3\n            )\n\n\n        else:\n\n            cv2.putText(\n\n                frame,\n\n                \"STATUS: NORMAL\",\n\n                (20, 45),\n\n                cv2.FONT_HERSHEY_SIMPLEX,\n\n                0.9,\n\n                (0, 255, 0),\n\n                2\n            )\n\n\n        # ----------------------------------------------------\n        # Probability\n        # ----------------------------------------------------\n\n        cv2.putText(\n\n            frame,\n\n            f\"Accident Probability: \"\n            f\"{smooth_probability:.1%}\",\n\n            (20, height - 60),\n\n            cv2.FONT_HERSHEY_SIMPLEX,\n\n            0.8,\n\n            (255, 255, 255),\n\n            2\n        )\n\n\n        cv2.putText(\n\n            frame,\n\n           